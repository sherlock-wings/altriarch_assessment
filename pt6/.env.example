# Copy to pt6/.env and fill in. pt6/.env is gitignored and must never be committed.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=CANDIDATE_CALLAHAN
SNOWFLAKE_WAREHOUSE=WH_CALLAHAN
SNOWFLAKE_DATABASE=CALLAHAN_DB

# snowflake_jwt (key pair) or username_password_mfa (password + Duo).
# Set the block below that matches; the other can stay empty.
SNOWFLAKE_AUTHENTICATOR=snowflake_jwt

SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=

SNOWFLAKE_PASSWORD=
